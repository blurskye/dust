# F3 search: cached hits while typing, the forge's results streamed in below
# a "From github.com" divider. Prime the cache first (forge-cached.keys, phase prime), then:
#   FORGE_CACHED_PHASE=search scripts/ui-shot scripts/ui-scenarios/forge-search.keys \
#     --binary scripts/ui-scenarios/forge-cached-launch --cwd /tmp/orbit --out target/ui-shots/forge-search
until Changes
wait 300
# Git → Pull requests → Issues
type >
wait 100
type >
wait 400
type /
wait 150
type crash
wait 120
shot local
wait 3000
shot remote
key escape
wait 300
