# F5 GitLab: merge requests, a merge request with discussions and
# approvals, issues and pipelines from the loopback fake GitLab (nested group orbit/team/orbit),
# in GitLab's words: "Merge requests", "!13", "Pipelines".
#   scripts/ui-scenarios/make-orbit-fixture.sh /tmp/orbit
#   DUSTY_GIT_BINARY=$PWD/target/release/dusty-git \
#     scripts/ui-shot scripts/ui-scenarios/forge-gitlab.keys \
#     --binary scripts/ui-scenarios/forge-gitlab-launch --cwd /tmp/orbit \
#     --size 190x48 --size 120x36 --size 100x30 --out target/ui-shots/forge-gitlab
until Changes
wait 300
# Git → Merge requests
type >
wait 300
until Merge requests
until Showing
gone Loading
shot merge-requests
# The reader, focused and scrolled to its end: the next step and its keys. (At 120 and 190
# the list already shows !13's overview, so a shot right after Enter would repeat it.)
key enter
wait 300
gone Loading
key end
wait 400
shot merge-request-next-step
key home
wait 200
# Reader tabs: Conversation │ Commits │ Pipelines │ Files changed. The Conversation tab ends
# with the merge readiness, which merge-request-next-step already shows.
# Files changed: the diff with its threads inline
type ]
type ]
type ]
wait 300
gone Loading
shot merge-request-files
# Back to Conversation (wraps past Files changed): the discussions and threads as cards
type ]
wait 300
gone Loading
shot merge-request-activity
key home
wait 200
key escape
wait 300
# !10: approved by alex, pipeline passed
key j j
key enter
wait 300
gone Loading
shot merge-request-approved
key escape
wait 300
# → Issues
type >
wait 300
until Showing
gone Loading
shot issues
# → Pipelines
type >
wait 300
gone Loading
shot pipelines
# Run history (focus 2), newest first: !13's failed merge request pipeline
type 2
key enter
wait 300
gone Loading
shot pipeline
# → To-dos (R16 gitlab-10): GitLab's to-do list is the Notifications page in GitLab's words
key escape
wait 300
type >
wait 300
gone Loading
shot todos
