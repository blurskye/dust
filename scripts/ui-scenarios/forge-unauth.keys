# F2 host states in the forge tabs (FORGE.md §2.5; DESIGN §3.45 X-OFFLINE / X-PROVIDER).
# One run per state against the loopback fake forge; each writes `notice` (the list's notice
# row) and `accounts` (the `a` popover):
#   scripts/ui-scenarios/make-orbit-fixture.sh /tmp/orbit
#   for state in signed-out cli-missing unknown-provider rate-limited; do
#     FORGE_UNAUTH_STATE=$state DUSTY_GIT_BINARY=$PWD/target/release/dusty-git \
#       scripts/ui-shot scripts/ui-scenarios/forge-unauth.keys \
#       --binary scripts/ui-scenarios/forge-unauth-launch --cwd /tmp/orbit \
#       --out target/ui-shots/forge-unauth-$state
#   done
until Changes
wait 300
# `>` steps the top tabs: Git → Pull requests → Issues → Actions.
key > >
wait 300
# Each state says itself in its own words (no shared phrase since the states pass), so wait
# for the list and for every read to end.
until Filters
gone Loading
wait 800
shot notice
type @
wait 500
shot accounts
key escape
wait 300
