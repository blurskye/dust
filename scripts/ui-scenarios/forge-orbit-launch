def check(name, conclusion, run, seconds=3):
    started = NOW - datetime.timedelta(minutes=9)
    return {"__typename": "CheckRun", "name": name, "conclusion": conclusion,
            "status": "COMPLETED" if conclusion else "IN_PROGRESS",
            "startedAt": started.isoformat().replace("+00:00", "Z"),
            "completedAt": (started + datetime.timedelta(seconds=seconds)).isoformat().replace("+00:00", "Z"),
            "detailsUrl": f"https://github.com/orbit-dev/orbit/actions/runs/{run}/job/{run * 10}",
            "workflowName": "Quality checks"}


