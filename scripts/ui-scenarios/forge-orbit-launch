def notification(ident, reason, kind, number, title, unread=True, **delta):
    path = {"PullRequest": "pulls", "Issue": "issues"}.get(kind)
    url = f"https://api.github.com/repos/orbit-dev/orbit/{path}/{number}" if path else None
    return {"id": ident, "unread": unread, "reason": reason, "updated_at": ago(**delta),
            "repository": {"full_name": "orbit-dev/orbit"},
            "subject": {"title": title, "type": kind, "url": url, "latest_comment_url": None}}


def step(number, name, conclusion, start, seconds):
    began = NOW - datetime.timedelta(days=1, seconds=-start)
    return {"name": name, "number": number, "status": "completed", "conclusion": conclusion,
            "startedAt": began.isoformat().replace("+00:00", "Z"),
            "completedAt": (began + datetime.timedelta(seconds=seconds)).isoformat().replace("+00:00", "Z")}


def stamp(seconds):
