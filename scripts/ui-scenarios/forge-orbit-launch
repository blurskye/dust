def pr(number, title, author, decision, checks, add, delete, updated, **extra):
    entry = dict(CLEAR, closingIssuesReferences=[], reviews=[], reviewRequests=[], commits=[
                     {"oid": f"{number:02d}c91d2" + "0" * 33, "messageHeadline": title, "messageBody": "",
                      "committedDate": updated, "authors": [{"login": author}]}],
                 mergeable="MERGEABLE", headRefOid=f"{number:02d}" + "a" * 38,
                 number=number, title=title, author=person(author), reviewDecision=decision,
                 statusCheckRollup=checks, additions=add, deletions=delete, changedFiles=2,
                 updatedAt=updated, createdAt=updated, labels=[], isDraft=False,
                 headRefName=f"feat/{number}", baseRefName="main", mergeStateStatus="BLOCKED",
                 files=[{"path": "orbit/queue.py", "additions": add - 2 if add > 2 else add, "deletions": delete},
                        {"path": "tests/test_queue.py", "additions": 2 if add > 2 else 0, "deletions": 0}],
                 body=f"{title}.")
    entry.update(extra)
    # The head is the branch's last commit, so merge's pinned SHA and Commits' Head agree.
    if "headRefOid" not in extra:
        entry["headRefOid"] = entry["commits"][-1]["oid"]
    return entry


