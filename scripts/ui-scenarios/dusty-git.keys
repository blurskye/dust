# The Dusty Git tour: the Git tab's panes, a commit, the keyboard sheet, then each forge tab,
# on the orbit world against the loopback fake forge (nothing reaches a real forge).
#   scripts/ui-scenarios/make-orbit-fixture.sh /tmp/orbit
#   DUSTY_GIT_BINARY=$PWD/target/debug/dusty-git scripts/ui-shot scripts/ui-scenarios/dusty-git.keys \
#     --binary scripts/ui-scenarios/forge-orbit-launch --cwd /tmp/orbit --out target/ui-shots/dusty-git \
#     --size 190x48 --size 120x36 --size 100x30
until Changes
wait 300
# Changes (2) has focus at start; put the cursor on orbit/queue.py (MM).
key j j j
wait 900
shot changes
# Panes: 2 Changes · 3 Branches · 4 History · 5 Stashes · 0 Reader.
key 3
wait 600
shot branches
key 4
wait 600
# Enter on the newest commit lists its files; Enter on a file shows its diff in the reader.
key enter
wait 300
gone Loading
shot commit-files
key enter
wait 300
gone Loading
key pagedown
wait 300
shot commit-diff
type ?
wait 400
shot keyboard
key escape
# Esc returns from the commit's files to History.
key escape
wait 300
# Top tabs: Git → Pull requests → Issues → Actions → Notifications (`>` next, `<` previous).
type >
wait 300
until Showing
gone Loading
shot prs
key enter
wait 300
gone Loading
# d: the pull request's Files tab.
type d
wait 300
gone Loading
shot pr-files
key escape
wait 200
type >
wait 300
until Showing
gone Loading
shot issues
type >
wait 300
gone Loading
shot actions
# Enter opens the run with its failing step unfolded; f shows the full job log.
key enter
wait 300
gone Loading
shot action-run
type f
wait 300
gone Loading
shot action-log
key escape
wait 200
type >
wait 300
until Repositories
gone Loading
shot notifications
