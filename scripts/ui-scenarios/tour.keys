# A walk through the main surfaces, from startup.
wait 800
shot 01-dashboard
key enter
wait 300
key space
wait 700
shot 02-leader-hints
key escape
key space space
wait 600
type main.rs
wait 600
shot 03-file-picker
key enter
wait 1500
shot 04-editor
key space e
wait 600
shot 05-explorer
key space
wait 700
shot 06-leader-from-explorer
key escape
key ctrl+l
wait 300
key ctrl+slash
wait 800
shot 07-terminal
key ctrl+slash
wait 300
key space slash
wait 300
type fn run
wait 1000
shot 08-grep
key escape escape
wait 200
key space g g
wait 800
shot 09-git
