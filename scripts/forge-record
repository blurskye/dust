# ---------------------------------------------------------------- writing / checking

def slug(read):
    return re.sub(r"[^a-z0-9]+", "-", re.sub(r"([a-z])([A-Z])", r"\1-\2", read).lower()).strip("-")


def write_fixture(args, rec, plan_mode):
    out = pathlib.Path(args.out)
    bodies = out / "bodies"
    bodies.mkdir(parents=True, exist_ok=True)
    manifest_path = out / "requests.json"
    existing = json.loads(manifest_path.read_text()) if manifest_path.exists() else None
    if existing and not plan_mode:
        raise SystemExit(f"{manifest_path} exists; delete it to re-record or use --plan to merge")
    redaction = (existing or {}).get("redaction", {})
    now = dt.datetime.now(dt.timezone.utc).replace(microsecond=0)
    red = Redactor(args.provider, args.host, args.repo, redaction.get("logins"), redaction.get("date_shift_seconds"))
    parsed = []
    for entry in rec.entries:
        value = None
        if not entry["text"]:
            try:
                value = json.loads(entry["raw"]) if entry["raw"] else None
            except ValueError:
                entry["text"] = True
        parsed.append(value)
        red.collect(value)
    for value in parsed:
        red.collect(value, identities=True)
    if red.shift is None:
        newest = None
        for entry, value in zip(rec.entries, parsed):
            blob = json.dumps(value) if value is not None else entry["raw"].decode("utf-8", "replace")
            for stamp in iso_times(blob):
                if stamp <= now and (newest is None or stamp > newest):
                    newest = stamp
        red.shift = int(((now - dt.timedelta(minutes=9)) - newest).total_seconds()) if newest else 0
    entries = list((existing or {}).get("entries", []))
    counters = {}
    for entry in entries:
        counters[slug(entry["read"])] = counters.get(slug(entry["read"]), 0) + 1
    target = red.target

    def body_name(read, ext):
        base = slug(read)
        counters[base] = counters.get(base, 0) + 1
        name = f"{base}.{ext}" if counters[base] == 1 else f"{base}-{counters[base]}.{ext}"
        while (bodies / name).exists():
            counters[base] += 1
            name = f"{base}-{counters[base]}.{ext}"
        return name

    def store(new):
        for index, old in enumerate(entries):
            if old["key"] == new["key"] and old.get("graphql", {}).get("variables") == new.get("graphql", {}).get("variables") \
                    and old.get("accept") == new.get("accept") and old.get("auth") == new.get("auth"):
                (bodies / old["body"]).unlink(missing_ok=True) if old.get("body") else None
                entries[index] = new
                return
        entries.append(new)

    for entry, value in zip(rec.entries, parsed):
        path = red.text(entry["path"])
        query = {k: red.text(str(v)) for k, v in entry["query"].items()}
        headers = {}
        for name, header in entry["headers"].items():
            if name in KEEP_HEADERS or name.startswith(("x-ratelimit-", "ratelimit-")):
                headers[name] = red.text(header)
        graphql = None
        if entry.get("graphql"):
            graphql = {"operation": entry["graphql"]["operation"],
                       "variables": red.structured(entry["graphql"]["variables"]),
                       "document": entry["graphql"]["document"]}
        key = make_key(entry["method"], path, query, graphql_op=graphql and graphql["operation"])
        if value is not None:
            ext, data = "json", json.dumps(red.structured(value), indent=2, ensure_ascii=False) + "\n"
        else:
            text = entry["raw"].decode("utf-8", "replace")
            ext = "diff" if entry["read"] in ("Diff", "CommitDiff") else "log" if entry["read"] == "JobLog" else "txt"
            data = red.text(text)
        name = body_name(entry["read"], ext) if entry["raw"] else None
        if name:
            (bodies / name).write_text(data)
        new = {"key": key, "read": entry["read"].split(":")[0], "method": entry["method"], "status": entry["status"],
               "headers": headers, "body": name, "synthesized": False}
        if ":" in entry["read"]:
            new["kind"] = entry["read"].split(":")[1]
        for field in ("kind", "part", "accept", "note"):
            if entry.get(field):
                new[field] = entry[field]
        if graphql:
            new["graphql"] = graphql
        if not rec.token and entry["status"] in (401, 403):
            new["auth"] = "none"
        if entry["truncated"]:
            new["truncated"] = True
            new["note"] = (new.get("note", "") + "; " if new.get("note") else "") + f"body capped at {CAP // 1024} KiB"
        store(new)
    if not plan_mode:
        for item in synth(args.provider, args.host, target, now):
            path = item["path"]
            body = item["request"]
            graphql = item["graphql"]
            key = make_key(item["method"], path, item["query"], body, graphql and graphql["operation"])
            name = None
            if item["value"] is not None:
                ext = "log" if item["text"] else "json"
                name = body_name(item["read"] + "Synth", ext)
                data = item["value"] if item["text"] else json.dumps(item["value"], indent=2) + "\n"
                (bodies / name).write_text(data)
            new = {"key": key, "read": item["read"], "method": item["method"], "status": item["status"],
                   "headers": item["headers"], "body": name, "synthesized": True, "doc": item["doc"]}
            if body is not None:
                new["request"] = body
            if graphql:
                new["graphql"] = graphql
            if item["accept"]:
                new["accept"] = item["accept"]
            if item.get("part"):
                new["part"] = item["part"]
            if item.get("auth") or any(old["key"] == key and old.get("auth") == "none" for old in entries):
                new["auth"] = "token"
            store(new)
    version = (existing or {}).get("server_version")
    for entry, value in zip(rec.entries, parsed):
        if entry["read"] == "Version" and isinstance(value, dict) and value.get("version"):
            version = value["version"]
    hashes = sorted(set(redaction.get("hashes", [])) | red.hashes)
    manifest = {"schema": 1, "provider": args.provider, "host": args.host, "api_base": args.api_base,
                "server_version": version, "recorded_at": (existing or {}).get("recorded_at") or now.isoformat().replace("+00:00", "Z"),
                "repo": target,
                "redaction": {"hashes": hashes, "logins": red.known, "date_shift_seconds": red.shift},
                "entries": entries}
    if plan_mode and existing:
        manifest["updated_at"] = now.isoformat().replace("+00:00", "Z")
    manifest_path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n")
    print(f"wrote {manifest_path} ({len(entries)} entries)")


def tokens(text):
    found = set()
    for pattern in (r"[\w.\-\[\]]+", r"[\w\-\[\]]+"):
        found.update(token.strip(".") for token in re.findall(pattern, text))
    for path in re.findall(r"[\w.\-]+(?:/[\w.\-]+)+", text):
        parts = path.split("/")
        for size in (2, 3):
            for start in range(len(parts) - size + 1):
                found.add("/".join(parts[start:start + size]))
    return found


def check_dir(directory, provider):
    problems = []
    manifest_path = directory / "requests.json"
    try:
        manifest = json.loads(manifest_path.read_text())
    except (OSError, ValueError) as error:
        return [f"{manifest_path}: {error}"]
    hashes = set(manifest.get("redaction", {}).get("hashes", []))
    for field in ("schema", "provider", "host", "recorded_at", "repo", "entries"):
        if field not in manifest:
            problems.append(f"{manifest_path}: missing {field}")
    seen = set()
    texts = []  # (where, text)
    for entry in manifest.get("entries", []):
        where = f"{manifest_path.name}:{entry.get('key')}"
        for field in ("key", "read", "status", "headers", "synthesized"):
            if field not in entry:
                problems.append(f"{where}: missing {field}")
        identity = (entry.get("key"), json.dumps(entry.get("graphql", {}).get("variables"), sort_keys=True),
                    entry.get("accept"), entry.get("auth"))
        if identity in seen:
            problems.append(f"{where}: duplicate entry")
        seen.add(identity)
        if entry.get("synthesized") and not entry.get("doc"):
            problems.append(f"{where}: synthesized without a doc URL")
        texts.append((manifest_path.name, json.dumps({k: v for k, v in entry.items() if k != "doc"})))
        if entry.get("body"):
            path = directory / "bodies" / entry["body"]
            try:
                text = path.read_text()
            except OSError as error:
                problems.append(f"{where}: {error}")
                continue
            if path.suffix == ".json":
                try:
                    json.loads(text)
                except ValueError as error:
                    problems.append(f"{path}: invalid JSON: {error}")
            texts.append((entry["body"], text))
    for where, text in texts:
        for pattern in TOKEN_PATTERNS[:4]:
            if pattern.search(text):
                problems.append(f"{where}: token-like text left: {pattern.pattern}")
        for match in EMAIL.finditer(text):
            if match.group(2) != "example.invalid" and match.group(1) != "git" and not match.group(2).endswith(".png"):
                problems.append(f"{where}: email left: {match.group(0)[:2]}…@{match.group(2)}")
        for match in AVATAR.finditer(text):
            if not re.search(r"/avatars/[\w.-]+\.png$", match.group(0)):
                problems.append(f"{where}: avatar URL left: {match.group(0)[:40]}")
        for token in tokens(text):
            if sha(token) in hashes:
                problems.append(f"{where}: original identifier left ({token[:2]}…, sha {sha(token)[:10]})")
    labels = {entry.get("read") + (":" + entry["kind"] if entry.get("kind") and entry.get("read") == "List" else "")
              for entry in manifest.get("entries", [])}
    for read, satisfied_by in READS.get(provider, {}).items():
        if not any(label in labels for label in satisfied_by):
            problems.append(f"coverage: no entry for Read {read}")
    for write in WRITES:
        if write not in labels:
            problems.append(f"coverage: no entry for Write {write}")
    return sorted(set(problems))


def check(args):
    root = pathlib.Path(args.out)
    directories = [root] if (root / "requests.json").exists() else sorted(p.parent for p in root.glob("versions/*/requests.json"))
    if not directories:
        print(f"{root}: no requests.json found")
        return 1
    failed = False
    for directory in directories:
        problems = check_dir(directory, args.provider)
        manifest = json.loads((directory / "requests.json").read_text()) if (directory / "requests.json").exists() else {}
        count = len(manifest.get("entries", []))
        synthesized = sum(1 for entry in manifest.get("entries", []) if entry.get("synthesized"))
        if problems:
            failed = True
            print(f"FAIL {directory} ({count} entries, {synthesized} synthesized)")
            for problem in problems:
                print("  - " + problem)
        else:
            print(f"ok   {directory} ({count} entries, {synthesized} synthesized, "
                  f"server {manifest.get('server_version')}, recorded {manifest.get('recorded_at')})")
    return 1 if failed else 0


def token_from(source, host):
    if source in (None, "none"):
        return None
    if source == "gh":
        result = subprocess.run(["gh", "auth", "token", "--hostname", host], capture_output=True, text=True,
                                env=dict(os.environ, GH_PROMPT_DISABLED="1", GH_DEBUG=""), timeout=10)
        if result.returncode != 0 or not result.stdout.strip():
            raise SystemExit("gh has no token for " + host)
        return result.stdout.strip()
    if source.startswith("env:"):
        value = os.environ.get(source[4:])
        if not value:
            raise SystemExit(f"{source[4:]} is not set")
        return value
    raise SystemExit("--token-from must be gh, env:NAME or none")


def run_plan(rec, plan_path):
    plan = json.loads(pathlib.Path(plan_path).read_text())
    owner, name = rec.repo.split("/")[0], rec.repo.split("/")[-1]

    def fill(value):
        if isinstance(value, str):
            return value.replace("{owner}", owner).replace("{repo}", name).replace("{fullPath}", rec.repo)
        if isinstance(value, dict):
            return {k: fill(v) for k, v in value.items()}
        if isinstance(value, list):
            return [fill(v) for v in value]
        return value
    for item in plan:
        item = fill(item)
        method = item.get("method", "GET").upper()
        body = item.get("body")
        if method == "POST" and isinstance(body, dict) and "query" in body:
            rec.graphql(item["read"], item["path"], body["query"], body.get("variables") or {},
                        kind=item.get("kind"), part=item.get("part"))
        elif method == "GET":
            rec.get(item["read"], item["path"], item.get("query"), accept=item.get("accept"),
                    kind=item.get("kind"), part=item.get("part"),
                    text=not (item.get("accept") or "application/json").endswith("json"))
        else:
            raise SystemExit(f"refusing {method} {item['path']}: forge-record never writes")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("provider", choices=sorted(RECORDERS))
    parser.add_argument("host")
    parser.add_argument("repo", help="owner/repo (GitLab: group/sub/project)")
    parser.add_argument("--out", required=True)
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--plan")
    parser.add_argument("--token-from", default=None)
    parser.add_argument("--api-base")
    parser.add_argument("--delay", type=float, default=1.0)
    args = parser.parse_args()
    if args.check:
        return check(args)
    if not args.api_base:
        if args.provider == "github":
            args.api_base = "https://api.github.com" if args.host == "github.com" else f"https://{args.host}/api/v3"
        else:
            args.api_base = f"https://{args.host}{API_PREFIX[args.provider]}"
    token = token_from(args.token_from, args.host)
    scheme = {"github": "Bearer", "gitlab": "Bearer"}.get(args.provider, "token")
    rec = Recorder(args.provider, args.host, args.repo, token, args.api_base, args.delay, scheme)
    if args.plan:
        run_plan(rec, args.plan)
    else:
        RECORDERS[args.provider](rec)
    write_fixture(args, rec, bool(args.plan))
    return 0


if __name__ == "__main__":
    sys.exit(main())
