#!/usr/bin/env python3
"""Run Dust in a real terminal (kitty on a headless X server) and take screenshots.

Usage:
    scripts/ui-shot SCENARIO [--binary PATH] [--cwd DIR] [--size 120x40 ...] [--out DIR]

A scenario is a text file with one step per line:

    key space e        press keys one after another (kitty key names: ctrl+h, escape, enter)
    type hello world   type literal text
    wait 300           sleep for milliseconds
    until Issues 10    wait until the screen shows this text (default 20 s, then fail)
    until 5000 Ready   the same with its own limit in milliseconds
    gone Loading…      wait until the screen no longer shows this text
    settle 15000 Load  wait up to 15 s for the text to go, never fail, print how long it took
    shot explorer      save OUT/<size>/explorer.png and explorer.txt (screen text)
    # comment

Dust runs with fresh XDG config/state/data/cache directories, so user configuration
never leaks into the screenshots. Needs Xvfb, kitty and ImageMagick's `import`.
"""

import argparse
import json
import os
import pathlib
import select
import shutil
import subprocess
import sys
import tempfile
import time

ROOT = pathlib.Path(__file__).resolve().parent.parent
FONT = "FiraCode Nerd Font"


def start_xvfb():
    """Start Xvfb on a display it picks itself (`-displayfd`). Choosing a free number here and
    then starting Xvfb on it raced between concurrent runs: two runs took the same number, one
    Xvfb failed, and both terminals drew on the survivor, so one run's screenshots came out
    black."""
    read_end, write_end = os.pipe()
    xvfb = subprocess.Popen(
        ["Xvfb", "-displayfd", str(write_end), "-screen", "0", "3840x2160x24", "-nolisten", "tcp"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        pass_fds=(write_end,),
    )
    os.close(write_end)
    number = b""
    deadline = time.monotonic() + 15
    while not number.endswith(b"\n") and time.monotonic() < deadline:
        ready, _, _ = select.select([read_end], [], [], 0.1)
        if ready:
            chunk = os.read(read_end, 16)
            if not chunk:
                break
            number += chunk
    os.close(read_end)
    if not number.strip().isdigit():
        xvfb.kill()
        sys.exit("Xvfb did not report a display number")
    return xvfb, int(number)


class StartupError(Exception):
    pass


def colours(png):
    result = subprocess.run(["identify", "-format", "%k", str(png)], capture_output=True, text=True)
    return int(result.stdout.strip() or 0) if result.stdout.strip().isdigit() else 0


def blank(png):
    """A terminal screenshot has many colours and real weight; a black frame has neither."""
    return png.stat().st_size < 5000 or colours(png) <= 2


def wait_for(predicate, timeout, what):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if predicate():
            return
        time.sleep(0.05)
    raise StartupError(f"timed out waiting for {what}")


class Terminal:
    def __init__(self, binary, cwd, columns, rows, workdir):
        self.workdir = workdir
        self.socket = workdir / "kitty.sock"
        self.kitty = None
        self.xvfb, self.display = start_xvfb()
        try:
            self.start(binary, cwd, columns, rows)
        except StartupError as error:
            self.close()
            log = workdir / "kitty.log"
            detail = log.read_text().strip() if log.exists() else ""
            sys.exit(f"{error}\n{detail}".strip())

    def start(self, binary, cwd, columns, rows):
        workdir = self.workdir
        wait_for(
            lambda: pathlib.Path(f"/tmp/.X11-unix/X{self.display}").exists(), 5, "Xvfb"
        )
        env = dict(os.environ)
        env.pop("WAYLAND_DISPLAY", None)
        env.update(
            DISPLAY=f":{self.display}",
            LIBGL_ALWAYS_SOFTWARE="1",
            TERM="xterm-kitty",
        )
        for name in ("CONFIG", "STATE", "DATA", "CACHE"):
            path = workdir / name.lower()
            path.mkdir(exist_ok=True)
            env[f"XDG_{name}_HOME"] = str(path)
        self.kitty = subprocess.Popen(
            [
                "kitty",
                "--config", "NONE",
                "-o", f"font_family={FONT}",
                "-o", "font_size=12",
                "-o", "allow_remote_control=yes",
                "-o", "linux_display_server=x11",
                "-o", "remember_window_size=no",
                "-o", f"initial_window_width={columns}c",
                "-o", f"initial_window_height={rows}c",
                "-o", "window_padding_width=0",
                "-o", "cursor_blink_interval=0",
                "-o", "confirm_os_window_close=0",
                "--listen-on", f"unix:{self.socket}",
                "--directory", str(cwd),
                str(binary),
            ],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=open(workdir / "kitty.log", "w"),
        )
        wait_for(self.socket.exists, 30, "kitty")
        wait_for(lambda: self.window_id() is not None, 30, "kitty window")

    def remote(self, *args, capture=False):
        command = ["kitty", "@", "--to", f"unix:{self.socket}", *args]
        result = subprocess.run(command, capture_output=True, text=True)
        if result.returncode != 0:
            return None
        return result.stdout if capture else ""

    def window_id(self):
        out = self.remote("ls", capture=True)
        if not out:
            return None
        return json.loads(out)[0]["platform_window_id"]

    def key(self, name):
        self.remote("send-key", name)
        time.sleep(0.03)

    def type(self, text):
        self.remote("send-text", "--", text)

    def shot(self, path):
        png = path.with_suffix(".png")
        # A blank capture (a window not yet drawn, or another display's) is retried, then
        # fails the run loudly instead of leaving a black PNG beside a good text dump.
        for attempt in range(4):
            subprocess.run(
                ["import", "-display", f":{self.display}", "-window", str(self.window_id()), str(png)],
                check=True,
            )
            if not blank(png):
                break
            time.sleep(0.5)
        else:
            sys.exit(f"{png}: blank screenshot ({png.stat().st_size} bytes, {colours(png)} colours)")
        text = self.remote("get-text", "--extent", "screen", capture=True) or ""
        path.with_suffix(".txt").write_text(text)

    def alive(self):
        return self.kitty.poll() is None

    def close(self):
        for process in (self.kitty, self.xvfb):
            if process is None:
                continue
            process.terminate()
            try:
                process.wait(5)
            except subprocess.TimeoutExpired:
                process.kill()


def wait_for_text(terminal, text, present, limit, where):
    """A readiness signal instead of a guessed sleep: poll the screen text until `text` shows
    (or, for `gone`, until it no longer does). A timeout or an exit fails the run with the
    screen it was waiting on, so a slow forge read never turns into a wrong screenshot."""
    deadline = time.monotonic() + limit / 1000
    screen = ""
    while time.monotonic() < deadline:
        if not terminal.alive():
            sys.exit(f"{where}: dust exited while waiting for '{text}'")
        screen = terminal.remote("get-text", "--extent", "screen", capture=True) or ""
        if (text in screen) == present:
            # One more frame: the text can land a paint ahead of the rest of the screen.
            time.sleep(0.15)
            return
        time.sleep(0.1)
    verb = "show" if present else "drop"
    sys.exit(f"{where}: the screen did not {verb} '{text}' within {limit} ms; it read:\n{screen}")


def run(scenario, binary, cwd, size, out):
    columns, rows = (int(part) for part in size.split("x"))
    out.mkdir(parents=True, exist_ok=True)
    workdir = pathlib.Path(tempfile.mkdtemp(prefix="dust-ui-shot-"))
    shots = []
    terminal = None
    try:
        terminal = Terminal(binary, cwd, columns, rows, workdir)
        time.sleep(0.5)
        for number, line in enumerate(scenario.read_text().splitlines(), 1):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            step, _, rest = line.partition(" ")
            if not terminal.alive():
                sys.exit(f"{scenario}:{number}: dust exited before '{line}'")
            if step == "key":
                for name in rest.split():
                    terminal.key(name)
            elif step == "type":
                terminal.type(rest)
            elif step == "wait":
                time.sleep(int(rest) / 1000)
            elif step in ("until", "gone"):
                limit, _, text = rest.partition(" ")
                if not (limit.isdigit() and text):
                    limit, text = "20000", rest
                wait_for_text(terminal, text, step == "until", int(limit), f"{scenario}:{number}")
            elif step == "settle":
                # Real forges: wait up to MS for TEXT to go, never fail, and say how long it
                # took, so a slow read is measured instead of aborting the run.
                limit, _, text = rest.partition(" ")
                started = time.monotonic()
                deadline = started + int(limit) / 1000
                screen = ""
                while time.monotonic() < deadline and terminal.alive():
                    screen = terminal.remote("get-text", "--extent", "screen", capture=True) or ""
                    if text not in screen:
                        break
                    time.sleep(0.1)
                took = int((time.monotonic() - started) * 1000)
                state = "still shown" if text in screen else "gone"
                print(f"settle {scenario.name}:{number} '{text}' {state} after {took} ms", flush=True)
            elif step == "shot":
                time.sleep(0.15)
                path = out / rest
                terminal.shot(path)
                shots.append(path.with_suffix(".png"))
            else:
                sys.exit(f"{scenario}:{number}: unknown step '{step}'")
    finally:
        if terminal is not None:
            terminal.close()
        shutil.rmtree(workdir, ignore_errors=True)
    return shots


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("scenario", type=pathlib.Path)
    parser.add_argument("--binary", type=pathlib.Path, default=ROOT / "target/release/dust")
    parser.add_argument("--cwd", type=pathlib.Path, default=ROOT)
    parser.add_argument("--size", action="append", help="COLUMNSxROWS, repeatable (default 120x40)")
    parser.add_argument("--out", type=pathlib.Path, default=ROOT / "target/ui-shots")
    args = parser.parse_args()
    if not args.binary.is_file():
        sys.exit(f"binary not found: {args.binary}")
    for size in args.size or ["120x40"]:
        out = args.out / args.scenario.stem / size
        for shot in run(args.scenario, args.binary.resolve(), args.cwd.resolve(), size, out):
            print(shot)


if __name__ == "__main__":
    main()
