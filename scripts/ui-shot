#!/usr/bin/env python3
"""Run Dust in a real terminal (kitty on a headless X server) and take screenshots.

Usage:
    scripts/ui-shot SCENARIO [--binary PATH] [--cwd DIR] [--size 120x40 ...] [--out DIR]

A scenario is a text file with one step per line:

    key space e        press keys one after another (kitty key names: ctrl+h, escape, enter)
    type hello world   type literal text
    wait 300           sleep for milliseconds
    shot explorer      save OUT/<size>/explorer.png and explorer.txt (screen text)
    # comment

Dust runs with fresh XDG config/state/data/cache directories, so user configuration
never leaks into the screenshots. Needs Xvfb, kitty and ImageMagick's `import`.
"""

import argparse
import json
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile
import time

ROOT = pathlib.Path(__file__).resolve().parent.parent
FONT = "FiraCode Nerd Font"


def free_display():
    for number in range(90, 140):
        if not pathlib.Path(f"/tmp/.X11-unix/X{number}").exists():
            return number
    sys.exit("no free X display number")


class StartupError(Exception):
    pass


def wait_for(predicate, timeout, what):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if predicate():
            return
        time.sleep(0.05)
    raise StartupError(f"timed out waiting for {what}")


class Terminal:
    def __init__(self, binary, cwd, columns, rows, workdir):
        self.workdir = workdir
        self.display = free_display()
        self.socket = workdir / "kitty.sock"
        self.kitty = None
        self.xvfb = subprocess.Popen(
            ["Xvfb", f":{self.display}", "-screen", "0", "3840x2160x24", "-nolisten", "tcp"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        try:
            self.start(binary, cwd, columns, rows)
        except StartupError as error:
            self.close()
            log = workdir / "kitty.log"
            detail = log.read_text().strip() if log.exists() else ""
            sys.exit(f"{error}\n{detail}".strip())

    def start(self, binary, cwd, columns, rows):
        workdir = self.workdir
        wait_for(
            lambda: pathlib.Path(f"/tmp/.X11-unix/X{self.display}").exists(), 5, "Xvfb"
        )
        env = dict(os.environ)
        env.pop("WAYLAND_DISPLAY", None)
        env.update(
            DISPLAY=f":{self.display}",
            LIBGL_ALWAYS_SOFTWARE="1",
            TERM="xterm-kitty",
        )
        for name in ("CONFIG", "STATE", "DATA", "CACHE"):
            path = workdir / name.lower()
            path.mkdir(exist_ok=True)
            env[f"XDG_{name}_HOME"] = str(path)
        self.kitty = subprocess.Popen(
            [
                "kitty",
                "--config", "NONE",
                "-o", f"font_family={FONT}",
                "-o", "font_size=12",
                "-o", "allow_remote_control=yes",
                "-o", "linux_display_server=x11",
                "-o", "remember_window_size=no",
                "-o", f"initial_window_width={columns}c",
                "-o", f"initial_window_height={rows}c",
                "-o", "window_padding_width=0",
                "-o", "cursor_blink_interval=0",
                "-o", "confirm_os_window_close=0",
                "--listen-on", f"unix:{self.socket}",
                "--directory", str(cwd),
                str(binary),
            ],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=open(workdir / "kitty.log", "w"),
        )
        wait_for(self.socket.exists, 30, "kitty")
        wait_for(lambda: self.window_id() is not None, 30, "kitty window")

    def remote(self, *args, capture=False):
        command = ["kitty", "@", "--to", f"unix:{self.socket}", *args]
        result = subprocess.run(command, capture_output=True, text=True)
        if result.returncode != 0:
            return None
        return result.stdout if capture else ""

    def window_id(self):
        out = self.remote("ls", capture=True)
        if not out:
            return None
        return json.loads(out)[0]["platform_window_id"]

    def key(self, name):
        self.remote("send-key", name)
        time.sleep(0.03)

    def type(self, text):
        self.remote("send-text", "--", text)

    def shot(self, path):
        subprocess.run(
            ["import", "-display", f":{self.display}", "-window", str(self.window_id()), str(path.with_suffix(".png"))],
            check=True,
        )
        text = self.remote("get-text", "--extent", "screen", capture=True) or ""
        path.with_suffix(".txt").write_text(text)

    def alive(self):
        return self.kitty.poll() is None

    def close(self):
        for process in (self.kitty, self.xvfb):
            if process is None:
                continue
            process.terminate()
            try:
                process.wait(5)
            except subprocess.TimeoutExpired:
                process.kill()


def run(scenario, binary, cwd, size, out):
    columns, rows = (int(part) for part in size.split("x"))
    out.mkdir(parents=True, exist_ok=True)
    workdir = pathlib.Path(tempfile.mkdtemp(prefix="dust-ui-shot-"))
    shots = []
    terminal = None
    try:
        terminal = Terminal(binary, cwd, columns, rows, workdir)
        time.sleep(0.5)
        for number, line in enumerate(scenario.read_text().splitlines(), 1):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            step, _, rest = line.partition(" ")
            if not terminal.alive():
                sys.exit(f"{scenario}:{number}: dust exited before '{line}'")
            if step == "key":
                for name in rest.split():
                    terminal.key(name)
            elif step == "type":
                terminal.type(rest)
            elif step == "wait":
                time.sleep(int(rest) / 1000)
            elif step == "shot":
                time.sleep(0.15)
                path = out / rest
                terminal.shot(path)
                shots.append(path.with_suffix(".png"))
            else:
                sys.exit(f"{scenario}:{number}: unknown step '{step}'")
    finally:
        if terminal is not None:
            terminal.close()
        shutil.rmtree(workdir, ignore_errors=True)
    return shots


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("scenario", type=pathlib.Path)
    parser.add_argument("--binary", type=pathlib.Path, default=ROOT / "target/release/dust")
    parser.add_argument("--cwd", type=pathlib.Path, default=ROOT)
    parser.add_argument("--size", action="append", help="COLUMNSxROWS, repeatable (default 120x40)")
    parser.add_argument("--out", type=pathlib.Path, default=ROOT / "target/ui-shots")
    args = parser.parse_args()
    if not args.binary.is_file():
        sys.exit(f"binary not found: {args.binary}")
    for size in args.size or ["120x40"]:
        out = args.out / args.scenario.stem / size
        for shot in run(args.scenario, args.binary.resolve(), args.cwd.resolve(), size, out):
            print(shot)


if __name__ == "__main__":
    main()
