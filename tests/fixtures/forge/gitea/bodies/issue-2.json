    },
    "original_author": "",
    "original_author_id": 0,
    "body": "Host machine Node is too indeterministic. I think bundling is the only realistic option to have a guaranteed working and compatible node version. GitHub currently runs all actions on Node 24, and I think next version will be 27.\n\nOnly by running the exact same version we can guarantee maximum compatibility.",
    "assets": [],
    "created_at": "2026-11-06T09:26:00Z",
    "updated_at": "2026-11-06T09:31:39Z"
  },
