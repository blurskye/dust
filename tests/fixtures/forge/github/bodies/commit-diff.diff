+	sending := make(chan struct{})
+	sent := make(chan struct{})
+	go func() {
+		close(sending)
+		p.Send("work")
+		close(sent)
+	}()
+	defer func() {
+		cancel()
+		awaitQuitLifecycle(t, sent, "Send cleanup")
+	}()
