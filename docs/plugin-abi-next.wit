// SPDX-License-Identifier: Apache-2.0
// Normative target only. Production accepts wit/dust-plugin.wit (0.2.0).
// Semantics, authority and bounds: extensions.md, ui.md, configuration.md.
package dust:plugin@0.3.0;

interface host {
  type handle = u64;
  type token = u64;
  type revision = u64;
  enum error-code {
    unavailable, invalid-argument, permission-denied, stale-source,
    foreign-handle, closed, queue-full, limit-exceeded, conflict,
    cancelled, worker-stopped, io-failure, protocol-failure,
    deadline-exceeded, exhausted, unknown-outcome, unsupported,
  }
  record failure { code: error-code, message: string, retryable: bool }
  variant scalar { text(string), boolean(bool), signed(s64), unsigned(u64) }
  record argument { name: string, value: scalar }
  enum execution-kind { command, view-event, provider, result-only, lifecycle }
  record ui-context {
    graph-revision: revision, tab: handle, window: handle,
    view: handle, content: handle, document-bytes: option<u64>,
  }
  record invocation {
    id: handle, kind: execution-kind, command: string,
    arguments: list<argument>, source: option<handle>, ui: option<ui-context>,
  }
  record limit { name: string, value: u64 }
  record feature { id: string, version: u32, available: bool }
  enum severity { info, warning, error }
  record notice { severity: severity, message: string }
  record rect { x: u16, y: u16, width: u16, height: u16 }
  enum edge { left, right, top, bottom }
  enum axis { horizontal, vertical }
  record tile { neighbor: option<handle>, axis: axis, after: bool, ratio: u16 }
  record dock { edge: edge, size: u16 }
  variant placement { tiled(tile), docked(dock), floating(rect), fullscreen, hidden }
  record place {
    window: handle, graph-revision: revision, tab: handle,
    placement: placement,
  }
  enum role { normal, muted, accent, selected, warning, error, border, success }
  enum node-kind {
    container, text, markdown, input, password, multiline, button,
    checkbox, choice, list-node, table, tree, tabs, split, progress, status,
  }
  record item {
    id: string, text: string, secondary: string, origin: string,
    status: string, enabled: bool, selected: bool, children: list<string>,
  }
  record node {
    id: handle, kind: node-kind, label: string, text: string,
    value: string, value-revision: revision, role: role,
    enabled: bool, required: bool, checked: bool,
    action: option<string>, items: list<item>, children: list<handle>,
  }
  record tree { revision: revision, root: handle, nodes: list<node> }
  record open-view {
    content-type: string, content: option<handle>, title: string,
    graph-revision: revision, tab: handle, placement: placement,
    tree: option<tree>,
  }
  record replace-tree { view: handle, expected: revision, tree: tree }
  record cell { x: u16, y: u16, grapheme: string, continuation: bool, role: role }
  record hit { bounds: rect, action: string, label: string }
  record cell-update {
    view: handle, dimensions-revision: revision, expected: revision,
    revision: revision, full: bool, dirty: list<rect>, cells: list<cell>,
    hits: list<hit>, cursor: option<tuple<u16, u16>>,
  }
  record focus { window: handle, graph-revision: revision }
  record close-view { view: handle, graph-revision: revision }
  variant ui-request {
    open(open-view), replace(replace-tree), cells(cell-update),
    place(place), focus(focus), close(close-view),
  }
  record ui-receipt {
    content: handle, view: handle, window: handle,
    graph-revision: revision, view-revision: revision,
  }
  enum answer { yes, no, cancelled }
  record confirmation { title: string, message: string, default: answer }
  enum input-kind { text, password, multiline }
  record input-request {
    title: string, label: string, kind: input-kind, initial: string,
    maximum-bytes: u32, required: bool, validate-command: option<string>,
  }
  record picker-row {
    id: string, primary: string, secondary: string, origin: string,
    status: string, selectable: bool, payload: list<u8>,
  }
  record picker-request {
    title: string, query: string, multiple: bool,
    provider: option<string>, rows: list<picker-row>,
  }
  record form-request { title: string, tree: tree, submit-action: string }
  variant interaction-request {
    confirmation(confirmation), input(input-request), picker(picker-request),
    form(form-request),
  }
  record field-error { field: handle, value-revision: revision, message: string }
  record validation {
    interaction: token, revision: revision, errors: list<field-error>, accept: bool,
  }
  record picked { id: string, payload: list<u8> }
  variant interaction-value {
    confirmation(answer), input(string), picked(list<picked>),
    form(list<argument>), cancelled,
  }
  record interaction-update {
    interaction: token, expected: revision, tree: option<tree>,
    rows: option<list<picker-row>>,
  }
  record snapshot-request {
    source: handle, start: u64, end: u64,
  }
  record snapshot {
    id: handle, document: handle, revision: revision,
    start: u64, end: u64, utf8: string, writable: bool,
  }
  record edit { start: u64, end: u64, replacement: string }
  record document-edit { snapshot: handle, edits: list<edit> }
  record proposal { label: string, documents: list<document-edit>, review: bool }
  record edit-receipt { transaction: handle, documents: list<tuple<handle, revision>> }
  record virtual-update {
    request: token, expected: revision, revision: revision,
    text: option<string>, edits: list<edit>, language: option<string>,
  }
  enum provider-kind {
    picker, completion, inline-completion, hover, signature,
    diagnostics, format, code-actions, symbols, references, rename,
    inlay, lenses, decorations, tasks, tests, scm, context, model,
  }
  record provider-request {
    id: token, provider: string, kind: provider-kind,
    source: option<handle>, query: string, context-json: string,
    maximum-items: u32, maximum-bytes: u32,
  }
  // JSON is a closed provider-kind-specific schema, not an executable escape.
  record provider-chunk {
    request: token, sequence: u32, items-json: string,
    final: bool, error: option<failure>,
  }
  enum storage-scope { global, workspace }
  record storage-key { scope: storage-scope, key: string }
  record storage-put {
    key: storage-key, expected: option<revision>, bytes: list<u8>,
  }
  record storage-delete { key: storage-key, expected: revision }
  record storage-list { scope: storage-scope, prefix: string, after: option<string>, limit: u16 }
  variant storage-request {
    get(storage-key), put(storage-put), delete(storage-delete), list-keys(storage-list),
  }
  record storage-value { key: storage-key, revision: revision, bytes: list<u8> }
  record storage-page { keys: list<string>, next: option<string> }
  variant storage-value-result { value(option<storage-value>), written(revision), deleted, page(storage-page) }
  record grant-request { declaration: string, reason: string }
  record file-read { grant: handle, path: string, offset: u64, maximum-bytes: u32 }
  record file-write {
    grant: handle, path: string, expected-read: handle, bytes: list<u8>,
  }
  record file-result { read: handle, exists: bool, bytes: list<u8>, eof: bool }
  variant environment-value { literal(string), secret(handle) }
  record environment-entry { name: string, value: environment-value }
  record process-request {
    grant: handle, executable: string, arguments: list<string>, cwd: string,
    environment: list<environment-entry>, stdin: list<u8>,
    deadline-ms: u32, maximum-output-bytes: u32,
  }
  record terminal-request { process: process-request, title: string }
  record header { name: string, value: environment-value }
  record https-request {
    grant: handle, method: string, url: string, headers: list<header>,
    body: list<u8>, deadline-ms: u32, maximum-response-bytes: u32,
  }
  record secret-request { grant: handle, name: string }
  record clipboard-write { grant: handle, text: string }
  record external-url { grant: handle, url: string }
  record command-request { grant: handle, command: string, arguments: list<argument>, source: handle }
  record stop-request { grant: handle, process: handle }
  variant service-request {
    read-file(file-read), write-file(file-write), process(process-request),
    terminal(terminal-request), https(https-request), secret(secret-request),
    read-clipboard(handle), write-clipboard(clipboard-write),
    open-url(external-url), command(command-request), stop(stop-request),
  }
  enum output-stream { stdout, stderr, response-body }
  record output-chunk { channel: output-stream, bytes: list<u8>, sequence: u32 }
  record process-result {
    process: handle, exit-code: option<s32>, signal: option<s32>, io-complete: bool,
  }
  record https-result { status: u16, headers: list<tuple<string, string>>, bytes: u64 }
  variant service-value {
    file(file-result), written, process(process-result), terminal(ui-receipt),
    https(https-result), secret(handle), clipboard(string), done,
  }
  record ui-action {
    view: handle, revision: revision, node: handle, action: string,
    arguments: list<argument>,
  }
  record dimensions { view: handle, revision: revision, width: u16, height: u16 }
  record changed {
    topic: string, source: handle, revision: revision,
    coalesced: u32, dropped: u32,
  }
  record virtual-request {
    id: token, definition: string, document: handle,
    revision: revision, context: list<argument>,
  }
  record submission {
    interaction: token, revision: revision, values: list<argument>,
  }
  variant event-value {
    action(ui-action), dimensions(dimensions), changed(changed),
    submission(submission), provider(provider-request), virtual-document(virtual-request),
    ui-result(tuple<token, result<ui-receipt, failure>>),
    interaction-result(tuple<token, result<interaction-value, failure>>),
    snapshot-result(tuple<token, result<snapshot, failure>>),
    edit-result(tuple<token, result<edit-receipt, failure>>),
    storage-result(tuple<token, result<storage-value-result, failure>>),
    grant-result(tuple<token, result<handle, failure>>),
    service-started(tuple<token, handle>),
    service-output(tuple<token, output-chunk>),
    service-result(tuple<token, result<service-value, failure>>),
    cancelled(token), closing,
  }
  record event { id: handle, context: invocation, value: event-value }

  features: func() -> list<feature>;
  limits: func() -> list<limit>;
  notify: func(message: notice) -> result<_, failure>;
  queue-ui: func(request: ui-request) -> result<token, failure>;
  queue-interaction: func(request: interaction-request) -> result<token, failure>;
  update-interaction: func(update: interaction-update) -> result<_, failure>;
  validate-submission: func(validation: validation) -> result<_, failure>;
  queue-snapshot: func(request: snapshot-request) -> result<token, failure>;
  propose-edits: func(proposal: proposal) -> result<token, failure>;
  publish-virtual: func(update: virtual-update) -> result<_, failure>;
  publish-provider: func(chunk: provider-chunk) -> result<_, failure>;
  queue-storage: func(request: storage-request) -> result<token, failure>;
  request-grant: func(request: grant-request) -> result<token, failure>;
  queue-service: func(request: service-request) -> result<token, failure>;
  cancel: func(request: token) -> result<_, failure>;
  release-handle: func(value: handle) -> result<_, failure>;
}

world editor-plugin {
  import host;
  use host.{invocation, event, failure};
  export activate: func() -> result<list<string>, failure>;
  export execute-command: func(invocation: invocation) -> result<_, failure>;
  export handle-events: func(events: list<event>) -> result<_, failure>;
  export deactivate: func() -> result<_, failure>;
}
